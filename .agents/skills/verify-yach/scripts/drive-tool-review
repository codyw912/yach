#!/usr/bin/env bash
# In review mode a bash request waits for the user. Approving runs it and
# shows its output; rejecting leaves the workspace untouched and tells the
# model the user declined.
set -euo pipefail
. "$(cd "$(dirname "$0")" && pwd)/lib/common.sh"

ev=$("$tty" evidence-dir yach)
ws="$state/run/workspace"

# Approve.
"$tty" stop "$session"
reset_run
printf 'one\ntwo\nthree\n' > "$ws/notes.txt"
write_script "$(bash_round 'wc -l notes.txt')" "$(text_round 'Counted the lines.')"
start_tui
ui_send "count the lines" 'Approve once' 15
capture "$ev/01-review-pending.txt"
expect "$ev/01-review-pending.txt" 'Review: pending'
expect "$ev/01-review-pending.txt" 'Command: wc -l notes\.txt'
ui_keys 'Counted the lines\.' Enter
capture "$ev/02-approved.txt"
expect "$ev/02-approved.txt" 'review approved'
expect "$ev/02-approved.txt" '3 notes\.txt'
"$tty" stop "$session"

# Reject: the third option. The file must survive.
reset_run
printf 'keep me\n' > "$ws/notes.txt"
write_script "$(bash_round 'rm notes.txt')" "$(text_round 'Left the file alone.')"
start_tui
ui_send "delete the notes" 'Approve once' 15
ui_keys '› Reject' Down Down
ui_keys 'Left the file alone\.' Enter
capture "$ev/03-rejected.txt"
expect "$ev/03-rejected.txt" 'review rejected'
expect "$ev/03-rejected.txt" 'user_rejected'
[[ -f "$ws/notes.txt" ]] || { echo "drive-tool-review: rejected rm still deleted notes.txt" >&2; exit 1; }
echo "notes.txt present after reject: $(cat "$ws/notes.txt")" > "$ev/04-workspace.txt"

"$tty" stop "$session"
echo "$ev"
