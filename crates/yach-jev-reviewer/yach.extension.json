{
  "schema": "yach.extension.v1",
  "id": "yach.jev-reviewer",
  "version": "0.1.0",
  "main": {
    "command": "yach",
    "args": ["__extension-host", "jev"]
  },
  "activation": {
    "events": ["postFirstPaint"]
  },
  "contributes": {
    "reviewer": {
      "reviewer_id": "jev-typesafe",
      "disclosure_summary": "Bounded action context is sent to the configured TypeSafe endpoint for assessment.",
      "remote": true
    }
  }
}
